<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline self-test for the DNS query feed (DnsQueryFeedService):
       synthetic EID-22 rows driven through the public Record/query API —
       no event channel, no network. Per the house pattern, the suite runs
       the shipped NetWatch assembly via ProjectReference. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DnsFeedSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\AutoCommand.NetWatch.Core\AutoCommand.NetWatch.Core.csproj" />
  </ItemGroup>

</Project>
