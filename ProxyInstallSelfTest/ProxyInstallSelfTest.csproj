<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline self-test for the AgentProxy install logic. Phase 6 of the
       AutoCommand II extraction (REWRITE.md): McpClientRegistration lives
       in core\AutoCommand.Agent.Core and this harness references the
       library — what runs here is the shipped assembly itself. Excluded
       from the app build (AutoCommand.csproj Compile Remove): own Main(). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ProxyInstallSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\AutoCommand.Agent.Core\AutoCommand.Agent.Core.csproj" />
  </ItemGroup>

</Project>
