<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline self-test for the Python Spawns tab's non-UI engine. Compiles
       the WPF-free services from the app project directly, so what runs here
       is byte-identical to what ships in AutoCommand. Excluded from the app
       build (AutoCommand.csproj Compile Remove, like ScratchTest): it has its
       own Main() and would double-define the linked service classes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PyTraceSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stream capture + TLS keylog/decrypt and their record models now
         come from the Intercept core library (phase 2 extraction,
         REWRITE.md) — this harness exercises the shipped assembly for
         those instead of a source copy. The PyTrace services themselves
         stay compiled here until their Forensics phase. -->
    <ProjectReference Include="..\core\AutoCommand.Intercept.Core\AutoCommand.Intercept.Core.csproj" />
    <Compile Include="..\Services\PyTraceInstallerService.cs" />
    <Compile Include="..\Services\PyTraceReaderService.cs" />
    <Compile Include="..\Helpers\MotwUnblocker.cs" />
    <Compile Include="..\Models\PyTraceRecord.cs" />
  </ItemGroup>

</Project>
