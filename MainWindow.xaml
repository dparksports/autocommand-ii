<Window x:Class="AutoCommand.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AutoCommand.Views"
        Title="Auto-Command" Height="750" Width="1200"
        Icon="app_icon.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content. The sidebar is grouped: WATCH (feeds that show what
             the machine is doing), CONTAIN (blocking & defenses), SYSTEM
             (everything configurational). Group headers are non-selectable
             TabItems; entries are single-line so all 14 fit without
             scrolling. SelectedIndex=1 skips the WATCH header explicitly. -->
        <TabControl x:Name="MainTabControl" Grid.Row="0" TabStripPlacement="Left" SelectedIndex="1">

            <!-- ═══ WATCH ═══ -->
            <TabItem x:Name="WatchHeaderItem" IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock x:Name="WatchHeaderText" Text="WATCH" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,2"
                               ToolTip="Feeds that show what this machine is running and where it connects."/>
                </TabItem.Header>
            </TabItem>
            <TabItem x:Name="ProcessMonitorNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Process Monitor" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SvchostMonitorView x:Name="SvchostTab"/>
            </TabItem>
            <TabItem x:Name="PhoneHomeNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📶" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Phone Home" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:PhoneHomeView x:Name="PhoneHomeTab"/>
            </TabItem>
            <TabItem x:Name="SpawnsNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧬" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Spawns" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SpawnsView x:Name="SpawnsTab"/>
            </TabItem>
            <TabItem x:Name="TracesNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔬" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Traces" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TracesView x:Name="TracesTab"/>
            </TabItem>
            <TabItem x:Name="BitsNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="BITS Transfers" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BitsView x:Name="BitsTab"/>
            </TabItem>
            <TabItem x:Name="TrafficNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Traffic Patterns" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TrafficPatternsView x:Name="TrafficPatternsTab"/>
            </TabItem>
            <TabItem x:Name="TransmissionsNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Transmissions" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:TransmissionsView x:Name="TransmissionsTab"/>
            </TabItem>
            <TabItem x:Name="SiteDoctorNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🩺" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Site Doctor" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SiteDoctorView x:Name="SiteDoctorTab"/>
            </TabItem>

            <!-- ═══ CONTAIN ═══ -->
            <TabItem IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock Text="CONTAIN" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,10,0,2"
                               ToolTip="Blocking, sinkholing and defenses — actions that stop things."/>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Firewall" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:FirewallSettingsView x:Name="FirewallTab"/>
            </TabItem>
            <TabItem x:Name="BlocksNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⛔" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Blocks" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BlocksView x:Name="BlocksTab"/>
            </TabItem>
            <TabItem x:Name="BlackHoleNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🚫" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Black Hole" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BlackHoleView x:Name="BlackHoleTab"/>
            </TabItem>
            <TabItem x:Name="DefenderNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🦠" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Windows Defender" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:DefenderView x:Name="DefenderTab"/>
            </TabItem>

            <!-- ═══ SYSTEM ═══ -->
            <TabItem x:Name="SystemHeaderItem" IsEnabled="False" Focusable="False">
                <TabItem.Header>
                    <TextBlock x:Name="SystemHeaderText" Text="SYSTEM" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,10,0,2"
                               ToolTip="AI access, privacy, Windows telemetry, Sysmon health and app settings."/>
                </TabItem.Header>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Be My Guest" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:BeMyGuestView x:Name="BeMyGuestTab"/>
            </TabItem>
            <TabItem x:Name="PrivacyNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔐" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Data &amp; Privacy" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:PrivacyView x:Name="PrivacyTab"/>
            </TabItem>
            <TabItem x:Name="OneSettingsNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="OneSettings" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:OneSettingsView x:Name="OneSettingsTab"/>
            </TabItem>
            <TabItem x:Name="SysmonNavItem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧭" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Sysmon Audit" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SysmonStatusView x:Name="SysmonTab"/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Settings" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Enforcer Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="EnforcerDot" Width="8" Height="8" Fill="#00E5FF" Margin="0,0,8,0"/>
                    <TextBlock x:Name="EnforcerStatusText" Text="Security Enforcer: Active" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Threat Alert -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock x:Name="ThreatAlertText" Text=""
                               Foreground="#E5A631" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Button x:Name="ReviewAlertBtn" Content="Review"
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            Visibility="Collapsed" Click="ReviewAlertBtn_Click"/>
                    <Button x:Name="RestoreInternetBtn" Content="🚑 Restore Internet"
                            Style="{StaticResource PrimaryButton}" Padding="8,2" FontSize="10" Margin="8,0,0,0"
                            ToolTip="Blocked something and lost connectivity? Disables ALL AutoCommand-created firewall block rules at once. Fully reversible — nothing is deleted."
                            Click="RestoreInternetBtn_Click"/>
                </StackPanel>

                <!-- Version -->
                <TextBlock x:Name="VersionText" Grid.Column="2" Text="AutoCommand"
                           Foreground="#5A5A62" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
