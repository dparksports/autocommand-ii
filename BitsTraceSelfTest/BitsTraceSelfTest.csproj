<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline self-test for the BITS Transfers tab's engine: compiles the
       services/models from the app project directly, so what runs here is
       byte-identical to what ships in AutoCommand. Excluded from the app
       build (AutoCommand.csproj Compile Remove, like TaskAttributionSelfTest):
       it has its own Main() and would double-define the linked classes.
       Everything is synthetic/offline — no COM, no DNS, no event log, and
       persistence is redirected to a temp dir. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BitsTraceSelfTest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- BITS-cluster sources still compiled here directly (they leave for a
         core of their own in a later phase). The NetWatch engines they
         build on — IpClassifier, RdapService, DnsResolutionService,
         IResolvableHost — now come from the NetWatch core library
         (phase 1 extraction, REWRITE.md), so this harness exercises the
         shipped assembly for those instead of a source copy. -->
    <ProjectReference Include="..\core\AutoCommand.NetWatch.Core\AutoCommand.NetWatch.Core.csproj" />
    <Compile Include="..\Services\BitsWatcherService.cs" />
    <Compile Include="..\Services\BitsReasonCatalog.cs" />
    <Compile Include="..\Services\BitsFirewallContextService.cs" />
    <Compile Include="..\Helpers\AuthenticodeVerifier.cs" />
    <Compile Include="..\Models\BitsJobItem.cs" />
    <Compile Include="..\Models\BitsJobStat.cs" />
  </ItemGroup>

</Project>
