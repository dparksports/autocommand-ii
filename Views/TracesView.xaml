<UserControl x:Class="AutoCommand.Views.TracesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AutoCommand.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
        <Style x:Key="VerdictChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#3398A2B3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictKind}" Value="normal">
                    <Setter Property="Background" Value="#3334D399"/>
                    <Setter Property="BorderBrush" Value="#34D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictKind}" Value="elevated">
                    <Setter Property="Background" Value="#33FBBF24"/>
                    <Setter Property="BorderBrush" Value="#FBBF24"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="🔬 Traces" Style="{DynamicResource PageHeader}"/>
            <TextBlock TextWrapping="Wrap" Margin="0,2,0,8" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Your tracing projects: pick any process (or one svchost service) and get its phone-home facts — frequency, destinations, volume, regularity — from the local archive. Projects are small JSON files you can copy, share and hand-edit; no re-programming."/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="NewBtn" Content="＋ New project" Padding="10,4" Margin="0,0,8,0" Click="NewBtn_Click"/>
            <Button x:Name="CopyBtn" Content="⧉ Copy definition" Padding="10,4" Margin="0,0,8,0" Click="CopyBtn_Click"/>
            <Button x:Name="DeleteBtn" Content="🗑 Delete" Padding="10,4" Margin="0,0,8,0" Click="DeleteBtn_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" Text=""/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- project list -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Projects" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,8,10,4"/>
                    <ListBox x:Name="ProjectList" Background="Transparent" BorderThickness="0"
                             Padding="4" HorizontalContentAlignment="Stretch"
                             SelectionChanged="ProjectList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <!-- selected project card -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="CardHost">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource VerdictChip}" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding VerdictText}"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="#14FFFFFF" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ChipProcess}"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>

                                        <TextBlock Text="{Binding Story}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding MetricsLine}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding BytesLine}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding DestinationsLine}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding BeaconLine}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding IdentityLine}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding ReceiptsLine}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="#34D399" Margin="0,0,0,3"
                                                   Visibility="{Binding ReceiptsLine, Converter={StaticResource NonEmptyToVis}}"/>
                                        <TextBlock Text="{Binding Footnote}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" Margin="0,0,0,6"/>

                                        <Button Content="⛔ Block this application" Padding="10,4" HorizontalAlignment="Left"
                                                Click="BlockAppBtn_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- new-project form -->
                    <Border x:Name="NewForm" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="New trace project" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBlock Text="Name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="FormName" Margin="0,2,0,8" Padding="4"/>
                            <TextBlock Text="Process to watch (image name, '*' wildcards — e.g. chrome.exe, msedge*, pythonw.exe)"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="FormProcess" IsEditable="True" Margin="0,2,0,8" Padding="4"/>
                            <TextBlock Text="Optional: svchost service key only (e.g. diagtrack) — leaves the process field ignored"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="FormService" Margin="0,2,0,8" Padding="4"/>
                            <TextBlock Text="Notes (shown on the card)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="FormNotes" Margin="0,2,0,10" Padding="4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Create" Padding="12,4" Margin="0,0,8,0" Click="CreateBtn_Click"/>
                                <Button Content="Cancel" Padding="12,4" Click="CancelBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
