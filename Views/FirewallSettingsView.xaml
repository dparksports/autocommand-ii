<UserControl x:Class="AutoCommand.Views.FirewallSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AutoCommand.Converters"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <converters:EnabledToColorConverter x:Key="EnabledToColor"/>
        <converters:ActionToColorConverter x:Key="ActionToColor"/>
        <converters:GroupSizeExpanderConverter x:Key="GroupSizeExpander"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Advanced Firewall Settings" Style="{StaticResource PageHeader}" Margin="0,0,0,4"/>
                <TextBlock Text="Manage Windows Defender Firewall profiles and port rules via native COM APIs." 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Quick Profile:" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProfileCombo" Width="340" Margin="0,0,8,0" SelectionChanged="ProfileCombo_SelectionChanged">
                    <ComboBoxItem Content="Custom (Current)" IsSelected="True"/>
                    <ComboBoxItem Content="Shields Up"
                                  ToolTip="Reset Windows Firewall to its default rule set (removes all custom rules, including AutoCommand's AC-BLOCK rules), then disable every remaining rule — blocks all unsolicited incoming traffic."/>
                    <ComboBoxItem Content="Shields Up + mDNS"
                                  ToolTip="Disables every grouped firewall rule, then re-enables only mDNS and Core Networking."/>
                    <ComboBoxItem Content="Allow Discovery + Cast"/>
                    <ComboBoxItem Content="Allow Sharing + Discovery + Remote Desktop"/>
                    <ComboBoxItem Content="Allow Sharing + Discovery"/>
                    <ComboBoxItem Content="Block Sharing + Discovery + Remote Desktop"/>
                </ComboBox>
                <Button x:Name="RefreshBtn" Content="↻ Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- View Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="InboundRadio" Content="Inbound Rules" IsChecked="True" 
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <RadioButton x:Name="OutboundRadio" Content="Outbound Rules" 
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0"
                         Checked="FilterChanged"/>
            <TextBlock x:Name="RuleCountText" Text="" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="20,0,0,0" VerticalAlignment="Center" FontSize="11"/>
            <Button x:Name="RebaselineBtn" Content="📌 Re-baseline" Margin="16,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="RebaselineBtn_Click"
                    ToolTip="Capture the current firewall state as the expected baseline. The Security Enforcer re-disables rules that drift from it (e.g. re-enabled after Windows Update)."/>
            <Button x:Name="PauseEnforcementBtn" Content="⏸ Pause auto-fix (15 min)" Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="PauseEnforcementBtn_Click"
                    ToolTip="Suspend baseline enforcement for 15 minutes while you edit rules externally (wf.msc / netsh). Re-baseline afterwards to adopt your changes."/>
            <Button x:Name="RenameLegacyBtn" Content="✏️ Rename legacy blocks" Margin="12,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="RenameLegacyBtn_Click" IsEnabled="False"
                    ToolTip="Recreate AutoCommand block rules still using the legacy 'AutoCommand IP Block / Process Block' names under the current AC-BLOCK naming. Lossless: descriptions carry over, redundant inbound duplicates are removed, protection unchanged."/>
            <TextBlock x:Name="BaselineStatusText" Text="" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11"/>
            <ProgressBar x:Name="ProfileProgress" Width="120" Height="14" IsIndeterminate="True"
                         Visibility="Collapsed" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="ProfileStatusText" Text="" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontStyle="Italic" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Rules Grid -->
        <DataGrid Grid.Row="2" x:Name="RulesGrid" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <Expander IsExpanded="{Binding Converter={StaticResource GroupSizeExpander}, Mode=OneWay}"
                                                  Background="{DynamicResource SurfaceAltBrush}"
                                                  BorderBrush="{DynamicResource BorderBrush}"
                                                  BorderThickness="1"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Expander.Header>
                                                <TextBlock FontWeight="SemiBold" FontSize="12" Padding="4"
                                                           Text="{Binding Name, StringFormat='{} {0}'}"/>
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledDisplay}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Enabled, Converter={StaticResource EnabledToColor}}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Action, Converter={StaticResource ActionToColor}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                <DataGridTextColumn Header="Group" Binding="{Binding DisplayGroup}" Width="150"/>
                <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                <DataGridTextColumn Header="Local Port" Binding="{Binding LocalPort}" Width="80"/>
                <DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteAddress}" Width="120"/>
                <DataGridTextColumn Header="Profile" Binding="{Binding Profile}" Width="100"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Toggle Rule" Click="ToggleRule_Click"/>
                    <MenuItem Header="Enable Entire Group" Click="EnableGroup_Click"/>
                    <MenuItem Header="Disable Entire Group" Click="DisableGroup_Click"/>
                    <Separator/>
                    <MenuItem Header="Save to Config" Click="SaveToConfig_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>

