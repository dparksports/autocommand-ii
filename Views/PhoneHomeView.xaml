<UserControl x:Class="AutoCommand.Views.PhoneHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AutoCommand.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
        <views:NullToVisibilityConverter x:Key="NullToVis"/>
        <views:CountToVisibilityConverter x:Key="CountToVis"/>

        <!-- verdict chip: green = inside the authored normal band,
             amber = above it, gray = no authored baseline -->
        <Style x:Key="VerdictChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#3398A2B3"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictKind}" Value="normal">
                    <Setter Property="Background" Value="#3334D399"/>
                    <Setter Property="BorderBrush" Value="#34D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictKind}" Value="elevated">
                    <Setter Property="Background" Value="#33FBBF24"/>
                    <Setter Property="BorderBrush" Value="#FBBF24"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- row verdict dot: same three states, one glyph -->
        <Style x:Key="VerdictDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="#98A2B3"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VerdictKind}" Value="normal">
                    <Setter Property="Fill" Value="#34D399"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VerdictKind}" Value="elevated">
                    <Setter Property="Fill" Value="#FBBF24"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <DockPanel>
        <!-- header -->
        <StackPanel DockPanel.Dock="Top" Margin="24,18,24,6">
            <TextBlock Text="📶 Phone Home" Style="{DynamicResource PageHeader}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="What Windows' own talkers are doing — pick a row for the full story: how often it phones out, to whom, and whether that's normal. Quiet the ones you don't want, with receipts."/>
            <TextBlock x:Name="StatusText" Text="Reading the archive…" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="11" Margin="24,6,24,10"
                   Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8"
                   Text="Frequencies come from the local Sysmon archive (last 24 h) and the live connection table — nothing leaves the machine. 'Quiet it' pins Microsoft's telemetry endpoints in the hosts file (127.0.0.1 sinkhole, so denied attempts stay visible here and in Black Hole); undo removes the pins. Destination blocks are ordinary AutoCommand firewall blocks — reversible from the Blocks tab."/>

        <!-- master-detail -->
        <Grid Margin="24,6,24,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: one compact row per service, many at once -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                    ClipToBounds="True">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Services (by measured connects/hr)"
                               FontSize="12" FontWeight="SemiBold" Margin="10,8,10,4"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ListBox x:Name="RowList" Background="Transparent" BorderThickness="0"
                             Padding="4" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Style="{StaticResource VerdictDot}" Margin="0,0,8,0"/>

                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <TextBlock Text="🔇" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsQuieted, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="Quieted — endpoints pinned, attempts denied"/>
                                            <TextBlock Text="⚠" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="#FBBF24"
                                                       Visibility="{Binding BeaconRegular, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="Regular-interval (beacon-like) pattern detected — see detail"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ChipProcess}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding RowMetrics}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- RIGHT: detail pane for the selected row -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding SelectedItem, ElementName=RowList, Converter={StaticResource NullToVis}}">
                    <StackPanel DataContext="{Binding SelectedItem, ElementName=RowList}"
                                MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,8,8">

                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource VerdictChip}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource ChipText}" Text="{Binding VerdictText}"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="#14FFFFFF" CornerRadius="9" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource ChipText}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ChipProcess}"/>
                                        </Border>
                                        <Border VerticalAlignment="Center" CornerRadius="9" Padding="8,2" Margin="6,0,0,0"
                                                Background="#14FFFFFF">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ChipImpactKind}" Value="high">
                                                            <Setter Property="Background" Value="#33F87171"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChipImpactKind}" Value="medium">
                                                            <Setter Property="Background" Value="#33FBBF24"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ChipImpactKind}" Value="normal">
                                                            <Setter Property="Background" Value="#3334D399"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding ChipImpact}"/>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>

                                <TextBlock Text="{Binding Story}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <!-- 24-hour histogram (oldest → newest, UTC buckets) -->
                                <TextBlock Text="Connects per hour, last 24 h" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                <Border Height="42" Background="#0EFFFFFF" CornerRadius="4" Padding="3,3,3,2"
                                        HorizontalAlignment="Left" MinWidth="280">
                                    <ItemsControl ItemsSource="{Binding Bars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Rectangle Width="9" Height="{Binding Height}" Margin="0,0,1,0"
                                                           Fill="#53B4E8" VerticalAlignment="Bottom"
                                                           ToolTip="{Binding Label}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <TextBlock Text="{Binding MetricsLine}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,3"/>
                                <TextBlock Text="{Binding BytesLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>

                                <TextBlock Text="Destinations (24 h)" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,2"/>
                                <ItemsControl ItemsSource="{Binding Destinations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Display}"/>
                                                <Button Grid.Column="1" Content="⛔ block" FontSize="11" Padding="6,1"
                                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Tag="{Binding Ip}"
                                                        Click="BlockOneBtn_Click"
                                                        ToolTip="Block this one destination (outbound firewall rule, reversible)"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No destinations in the archive window" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Visibility="{Binding Destinations.Count, Converter={StaticResource CountToVis}}"/>

                                <TextBlock Text="{Binding BeaconLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,3"/>
                                <TextBlock Text="{Binding IdentityLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding ReceiptsLine}" TextWrapping="Wrap" FontSize="12"
                                           Foreground="#34D399" Margin="0,0,0,3"
                                           Visibility="{Binding ReceiptsLine, Converter={StaticResource NonEmptyToVis}}"/>
                                <TextBlock Text="{Binding Footnote}" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔇 Quiet it — keep receipts" Margin="0,0,8,0" Padding="10,4"
                                            Visibility="{Binding CanQuiet, Converter={StaticResource BoolToVis}}"
                                            Click="QuietBtn_Click"/>
                                    <Button Content="↩ Undo quiet" Margin="0,0,8,0" Padding="10,4"
                                            Visibility="{Binding IsQuieted, Converter={StaticResource BoolToVis}}"
                                            Click="UndoQuietBtn_Click"/>
                                    <Button Content="⛔ Block top destinations" Padding="10,4"
                                            Click="BlockBtn_Click"
                                            ToolTip="Blocks this service's top 3 measured destinations at once"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- no-selection hint -->
                <TextBlock Text="Pick a service on the left to see its full story." FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding SelectedItem, ElementName=RowList, Converter={StaticResource NullToVis}, ConverterParameter=inverse}"/>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
