<UserControl x:Class="AutoCommand.Views.InvestigateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Process Investigation" Style="{StaticResource PageHeader}"/>
            <TextBlock Text="One click joins everything AutoCommand knows about a process — who launched it, what it connected to, whether anything was blocked — into a verdict and a report. Read-only."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,-12,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Input row -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SubjectBox" Height="30" VerticalContentAlignment="Center"
                     ToolTip="Process image name (e.g. Reolink.exe, chrome*) or a PID. A PID also answers WHO launched it; a name answers WHAT it connected to."/>
            <ComboBox x:Name="HoursBox" Grid.Column="1" Width="70" Height="30" Margin="8,0,0,0"
                      SelectedIndex="0" VerticalContentAlignment="Center"
                      ToolTip="How far back to read the recorded archive. Bigger windows scan more data and take longer.">
                <ComboBoxItem Content="6 h"/>
                <ComboBoxItem Content="12 h"/>
                <ComboBoxItem Content="24 h"/>
            </ComboBox>
            <Button x:Name="RunBtn" Grid.Column="2" Content="▶ Investigate" Style="{StaticResource PrimaryButton}"
                    Height="30" Margin="8,0,0,0" Padding="14,0" Click="RunBtn_Click"
                    ToolTip="Reads recorded archives only — Sysmon archive, provenance records, block-hit feed. Captures nothing, blocks nothing, changes nothing."/>
            <TextBlock x:Name="ProgressText" Grid.Column="3" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- Verdict -->
        <Border x:Name="VerdictPanel" Grid.Row="2" CornerRadius="4" BorderThickness="1" Padding="14,10"
                Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="VerdictHeadline" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="VerdictDetail" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Report action row -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
            <Button x:Name="CopyBtn" Content="⧉ Copy report" Style="{StaticResource PrimaryButton}"
                    FontSize="12" Padding="10,3" Margin="0,0,8,0" Visibility="Collapsed" Click="CopyBtn_Click"
                    ToolTip="Copies the full plain-text report — the same text the investigate_process AI tool returns."/>
            <Button x:Name="SaveBtn" Content="💾 Save report" Style="{StaticResource PrimaryButton}"
                    FontSize="12" Padding="10,3" Visibility="Collapsed" Click="SaveBtn_Click"
                    ToolTip="Writes the report to %LOCALAPPDATA%\AutoCommand\reports\ as markdown."/>
        </StackPanel>

        <!-- Report text -->
        <TextBox x:Name="ReportBox" Grid.Row="4" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                 Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Visibility="Collapsed"/>

        <TextBlock Grid.Row="5" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Verdicts describe the recorded numbers — they are not baselines. 'Outbound attempts, none completed' means every external destination shows one-way traffic only; judge completed conversations by the Transmissions tab."/>
    </Grid>
</UserControl>
