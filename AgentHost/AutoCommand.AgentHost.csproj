<Project Sdk="Microsoft.NET.Sdk">

  <!-- The headless agent face (phase 6, REWRITE.md): a tiny console host
       over the same Agent core the WPF app uses — an AI-access MCP session
       without booting the WPF application. This is the "one engine, many
       faces" payoff: AgentBridgeService/AgentToolRegistry run identically
       here because no core references WPF.

       No confirmation seam is installed (Sdk\IAgentInteraction stays null),
       so mutating tools are ALWAYS denied here — a headless session can
       answer questions, never change anything.

       NOTE for MCP registration: desktop clients must keep spawning the
       asInvoker AutoCommand.AgentProxy, which forwards to the elevated
       app's listener — never this exe (it neither elevates nor owns the
       app's Settings flow). AgentHost is for scripts and unattended runs:
       AutoCommand.AgentHost [seconds]   (0/omitted = until stdin closes)

       asInvoker: never needs UAC; it sees only what a normal user sees,
       and degrades its answers accordingly (same contract as the app's
       agent-headless launch path). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AutoCommand.AgentHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\AutoCommand.Agent.Core\AutoCommand.Agent.Core.csproj" />
  </ItemGroup>

</Project>
